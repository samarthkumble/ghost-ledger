# Copy to .env and fill in. Never commit .env.

# Auth0 (Regular Web Application). Allowed Callback URLs must include http://localhost:8765/callback
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Where demo letters go. The demo estate's banks are fictional, so every letter goes to an inbox you
# control; plus-addressing keeps institutions apart (you+malnadcooperative@gmail.com).
GHOST_DEMO_TO=you@gmail.com

# guardian = approve each letter on your phone (Auth0 CIBA + Guardian); console = approve from the CLI
GHOST_APPROVER=guardian
# gmail = send through Gmail via Token Vault; outbox = write .eml files to out/outbox (no accounts needed)
GHOST_SENDER=gmail

# One "day" in claim workflows. 86400 for real use; 20 makes the 15-day wait take 5 minutes.
GHOST_DAY_SECONDS=86400

TEMPORAL_ADDRESS=localhost:7233
GHOST_MODEL=gemma4:e4b
